{
  "id": "js5umkmMonitoring01",
  "name": "umkm-monitoring",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/10 * * * *"
            }
          ]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Schedule */10 menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        -300,
        0
      ],
      "notes": "Aktifkan hanya saat uji; nonaktifkan lagi setelah selesai (JS-5)."
    },
    {
      "parameters": {
        "url": "={{ $env.RAPOR_BASE_URL + '/api/pemantauan' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.N8N_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Ambil /api/pemantauan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -80,
        0
      ],
      "notes": "RAPOR_BASE_URL diatur di docker-compose/.env."
    },
    {
      "parameters": {
        "jsCode": "// HTTP Request mengembalikan satu item berisi { success, data: [...] }.\n// Pecah array data menjadi satu item per UMKM agar bisa diolah Edit Fields.\nconst res = $input.first().json;\nconst rows = Array.isArray(res.data) ? res.data : (Array.isArray(res) ? res : []);\nreturn rows.map((row) => ({ json: row }));"
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Pecah Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        140,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d2000000-0000-4000-8000-000000000001",
              "name": "waktu_format",
              "value": "={{ $now.setZone('Asia/Jakarta').setLocale('id').toFormat('dd MMMM yyyy HH:mm') }}",
              "type": "string"
            },
            {
              "id": "d2000000-0000-4000-8000-000000000002",
              "name": "total_skor",
              "value": "={{ Number($json.total_skor) }}",
              "type": "number"
            },
            {
              "id": "d2000000-0000-4000-8000-000000000003",
              "name": "status_message",
              "value": "={{ $json.status + ' - ' + $json.nama_umkm }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Rapikan Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        360,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d2000000-0000-4000-8000-000000000004",
              "leftValue": "={{ $json.total_skor }}",
              "rightValue": 13,
              "operator": {
                "type": "number",
                "operation": "smaller"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Kritis? (<13)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        580,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO prediksi_log (id_umkm, total_skor, status, sumber)\nVALUES ($1, $2, $3, 'schedule')\nRETURNING log_id;",
        "options": {
          "queryReplacement": "={{ [$json.id_umkm, $json.total_skor, $json.status] }}"
        }
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Catat skor kritis",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        840,
        -140
      ],
      "credentials": {
        "postgres": {
          "id": "rapor-postgres-01",
          "name": "Postgres Rapor Usaha"
        }
      },
      "notes": "sumber = schedule (JS-7)."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Susun email untuk satu UMKM dengan skor kritis (<13).\nconst u = $json;\nconst waktu = u.waktu_format\n  || $now.setZone('Asia/Jakarta').setLocale('id').toFormat('dd MMMM yyyy HH:mm');\nconst tren = u.perubahan == null\n  ? 'belum ada survei sebelumnya'\n  : (u.perubahan > 0 ? 'naik ' : u.perubahan < 0 ? 'turun ' : 'tetap ')\n    + Math.abs(u.perubahan) + ' poin dari ' + u.skor_sebelumnya;\nconst subject = '[Rapor Usaha] Prioritas Intervensi: ' + u.nama_umkm + ' (' + u.id_umkm + ')';\nconst text = [\n  'Halo Pendamping UMKM,',\n  '',\n  'Pemantauan terjadwal menemukan UMKM dengan skor kritis:',\n  '',\n  '  UMKM        : ' + u.nama_umkm + ' (' + u.id_umkm + ')',\n  '  Sektor/Kota : ' + (u.nama_sektor ?? '-') + ' / ' + (u.kota ?? '-'),\n  '  Survei      : ' + (u.tanggal ?? '-'),\n  '  Total skor  : ' + u.total_skor + ' dari 30 (' + tren + ')',\n  '  Status      : ' + u.status + ' - ' + (u.label ?? 'Prioritas Intervensi'),\n  '',\n  'Segera jadwalkan konsultasi dengan pemilik UMKM.',\n  '',\n  'Waktu pengecekan: ' + waktu + ' WIB',\n  '-- Dikirim otomatis oleh workflow n8n umkm-monitoring',\n].join('\\n');\nreturn { json: { ...u, to: $env.ALERT_EMAIL_TO, subject, text } };"
      },
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Susun Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        60
      ],
      "notes": "Satu item = satu email (subjek + isi teks) per UMKM kritis."
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.ALERT_EMAIL_FROM }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Kirim Email",
      "type": "n8n-nodes-base.sendEmail",
      "typeVersion": 2.1,
      "position": [
        1060,
        60
      ],
      "credentials": {
        "smtp": {
          "id": "rapor-smtp-01",
          "name": "Rapor Usaha SMTP"
        }
      },
      "notes": "Gmail SMTP (smtp.gmail.com:465, App Password). Pengirim/penerima dari env ALERT_EMAIL_FROM/ALERT_EMAIL_TO."
    },
    {
      "parameters": {},
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Tidak ada skor kritis",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        840,
        220
      ]
    }
  ],
  "connections": {
    "Schedule */10 menit": {
      "main": [
        [
          {
            "node": "Ambil /api/pemantauan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ambil /api/pemantauan": {
      "main": [
        [
          {
