            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pecah Data": {
      "main": [
        [
          {
            "node": "Rapikan Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rapikan Data": {
      "main": [
        [
          {
            "node": "Kritis? (<13)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kritis? (<13)": {
      "main": [
        [
          {
            "node": "Catat skor kritis",
            "type": "main",
            "index": 0
          },
          {
            "node": "Susun Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Tidak ada skor kritis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Susun Email": {
      "main": [
        [
          {
            "node": "Kirim Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta",
    "saveManualExecutions": true,
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
