# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.

# --- Docker Compose (Postgres + n8n) ---
POSTGRES_USER=umkm_admin
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=umkm
# Kunci enkripsi n8n (string acak panjang, simpan baik-baik)
N8N_ENCRYPTION_KEY=ganti_dengan_string_acak_panjang

# --- Aplikasi web ---
# Lokal (docker compose): postgresql://USER:PASS@localhost:5432/DB
# Neon/Vercel: pakai string dari dashboard (sslmode=require) atau sslmode=verify-full
DATABASE_URL=postgresql://umkm_admin:ganti_dengan_password_kuat@localhost:5432/umkm
# Rahasia penanda-tangan JWT, minimal 32 karakter acak
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
# Kosong = mode lokal. Isi URL webhook n8n = mode n8n
N8N_WEBHOOK_URL=
# Kunci akses otomasi n8n (header x-api-key). Kosong = jalur API-key nonaktif
N8N_API_KEY=
# Kode undangan pendaftaran staf (analis/pendamping). KOSONG = pendaftaran staf ditutup.
STAF_INVITE_CODE=
# Rahasia bersama ke webhook n8n, dikirim sebagai header x-webhook-secret.
# Di node Webhook n8n pilih Authentication = Header Auth dengan nama header tersebut. Kosong = tidak dikirim.
N8N_WEBHOOK_SECRET=
# Alamat web app dari dalam container n8n (Schedule JS-5 memanggil /api/pemantauan).
# Lokal: host.docker.internal:3000. Produksi: URL Vercel, mis. https://rapor-usaha.vercel.app
RAPOR_BASE_URL=http://host.docker.internal:3000
# API key Public API n8n (Settings > n8n API) untuk scripts/setup-n8n.mjs.
# Kosong = isi kredensial/workflow manual lewat UI.
N8N_URL=http://localhost:5678
N8N_PUBLIC_API_KEY=
# Port dev-server lokal
PORT=3000
